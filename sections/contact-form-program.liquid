<div class="index-section newsletter-{{ section.id }} color-scheme-{{ section.settings.color_scheme }}">
  {%- if section.settings.color_scheme != 'none' -%}
    {%- render 'color-scheme-texture', color_scheme: section.settings.color_scheme -%}
  {%- endif -%}
  <div class="page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %}">
    
        {%- if section.settings.title != blank or section.settings.text != blank -%}
      <div class="section-header text-center">
        {%- if section.settings.title != blank -%}
         <h2 class="section-header__title ">
            {{ section.settings.title }}
          </h2>
        {%- endif -%} 
  
      </div>
    {% endif %}
    
    <div class="contact-cover-div flex flex-flow">
    <div class="contact-leftbar">
      {% if section.settings.title2 != blank %} <h4 class="line-title"><span> {{section.settings.title2}} </span></h4> {% endif %}
           {%- if section.settings.text != blank -%}
          <div class="rte section-header__rte">{{ section.settings.text }}</div>
        {%- endif -%} 
      
      <ul class="contact-page-icon flex flex-flow">
        {% if section.settings.phone != blank %}
        <li>
          <img src="//cdn.shopify.com/s/files/1/0629/2956/7962/files/phone.svg?v=1650366474">
          <span>  {{section.settings.phone}}</span>
        </li>
        {% endif %}
        
         {% if section.settings.email != blank %}
        <li>
              <img src="//cdn.shopify.com/s/files/1/0629/2956/7962/files/email.svg?v=1650366474">
          <span>  {{section.settings.email}}</span>
        </li>
        {% endif %}
        
        
         {% if section.settings.address != blank %}
        <li>
              <img src="//cdn.shopify.com/s/files/1/0629/2956/7962/files/home.svg?v=1650366474">
          <span>  {{section.settings.address}}</span>
        </li>
        {% endif %}
        
         {% if section.settings.Promotion != blank %}
        <li>
              <img src="https://cdn.shopify.com/s/files/1/0629/2956/7962/files/rocker2.svg?v=1652809656">
          <span>  {{section.settings.Promotion}}</span>
        </li>
        {% endif %}
        
      </ul>
      
    </div>
    
    <div class="contact-rightbar">

  {% if section.settings.title3 != blank %} <h4 class="line-title"><span> {{section.settings.title3}} </span></h4> {% endif %}
      
    <div class="form-vertical">
      {%- assign form_id = 'contact-' | append: section.id -%}
      {%- form 'contact', id: form_id -%}

        {%- if form.posted_successfully? -%}
          <p class="note note--success">
            {{ 'contact.form.post_success' | t }}
          </p>
        {%- endif -%}

        {{ form.errors | default_errors }}

        <div class="grid grid--small">
          <div class="grid__item medium-up--one-half">
            <label for="ContactFormName-{{ section.id }}">{{ 'contact.form.name' | t }}</label>
            <input type="text" id="ContactFormName-{{ section.id }}" class="input-full" name="contact[name]" autocapitalize="words" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
          </div>

          <div class="grid__item medium-up--one-half">
            <label for="ContactFormEmail-{{ section.id }}">{{ 'contact.form.email' | t }}</label>
            <input type="email" id="ContactFormEmail-{{ section.id }}" class="input-full" name="contact[email]" autocorrect="off" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
          </div>
        </div>

        {%- if section.settings.show_phone -%}
          <label for="ContactFormPhone-{{ section.id }}">{{ 'contact.form.phone' | t }}</label>
          <input type="tel" id="ContactFormPhone-{{ section.id }}" class="input-full" name="contact[phone]" pattern="[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
        {%- endif -%}

      <div class="section-header ">
        {%- if section.settings.title1 != blank -%}
          <h2 class="section-header__title">
            {{ section.settings.title1 }}
          </h2>
        {%- endif -%}
      </div>
      
        <div class="grid grid--small">
          <div class="grid__item medium-up--one-half">
            <label for="ContactFormNamee-{{ section.id }}">{{ 'contact.form.name' | t }}</label>
            <input type="text" id="ContactFormNamee-{{ section.id }}" class="input-full" name="contact[name]" autocapitalize="words" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
          </div>

          <div class="grid__item medium-up--one-half">
          <label for="ContactFormemail-{{ section.id }}">{{ 'contact.form.email' | t }}</label>
            <input type="text" id="ContactFormemail-{{ section.id }}" class="input-full" name="contact[Email]" autocapitalize="words" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
          </div>
        </div>
      
            <label for="ContactFormName-Address">Address</label>
            <input type="text" id="ContactFormName-Address" class="input-full" name="contact[Address]" autocapitalize="words" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">

      
       <label for="ContactFormName-Address">Number of Students</label>
       <input type="text" id="ContactFormName-Address" class="input-full" name="contact[students]" autocapitalize="words" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">

          <label for="ContactFormName-Address">Website</label>
          <input type="text" id="ContactFormName-Address" class="input-full" name="contact[Website]" autocapitalize="words" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">

      
      
      
        <label for="ContactFormMessage-{{ section.id }}">{{ 'contact.form.message' | t }}</label>
        <textarea rows="5" id="ContactFormMessage-{{ section.id }}" class="input-full" name="contact[body]">{% if form.body %}{{ form.body }}{% endif %}</textarea>

       <input id="form-data" type="hidden"  class="input-full" name="contact[Form Teacher Registration page]" />
    
       <input id="form-data" type="hidden"  class="input-full" name="contact[Form Teacher Registration page]" value="{{ shop.url }}/pages/{{page.handle}}" />
      
      
        <button type="submit" class="btn">
          {{ 'contact.form.send' | t }}
        </button>

        {% comment %}
          Remove the following three lines of code to remove the note
          about being protected by Google's reCAPTCHA service.
          By removing it, the small reCAPTCHA widget will appear in the
          bottom right corner of the page.
        {% endcomment %}
        {{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}

      {%- endform -%}
    </div>
  </div>
    
    </div>
    
    </div>
</div>


