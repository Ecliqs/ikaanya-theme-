
{%- assign swatch_file_extension = 'png' -%}

{%- liquid
  assign is_size = false
  assign size_trigger = 'products.general.size_trigger' | t | downcase
  assign downcased_option = option.name | downcase

  if downcased_option contains size_trigger
    assign is_size = true
  endif
-%}

{%- capture size_chart_title -%}
  {{ 'products.general.size_chart' | t }} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-size-chart" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path class="a" d="M22.39 33.53c-7.46 0-13.5-3.9-13.5-8.72s6-8.72 13.5-8.72 13.5 3.9 13.5 8.72a12 12 0 0 1-.22 1.73"/><ellipse cx="22.39" cy="24.81" rx="3.28" ry="2.12"/><path class="a" d="M8.89 24.81V38.5c0 7.9 6.4 9.41 14.3 9.41h31.92V33.53H22.39M46.78 33.53v7.44M38.65 33.53v7.44M30.52 33.53v7.44M22.39 33.53v7.44"/></svg>
{%- endcapture -%}
{%- capture size_chart_content -%}
  {%- if block.settings.size_chart and block.settings.size_chart.content != blank -%}
    {{ block.settings.size_chart.content }}
  {%- elsif product.metafields.product.size_guid_image.value != blank -%}
    <img
      src="{{ product.metafields.product.size_guid_image.value | image_url: width: 1200 }}"
      alt="{{ 'products.general.size_chart' | t | escape }}"
      loading="lazy"
    >
  {%- elsif product.metafields.product.size_guid_image != blank -%}
    <img
      src="{{ product.metafields.product.size_guid_image }}"
      alt="{{ 'products.general.size_chart' | t | escape }}"
      loading="lazy"
    >
  {%- endif -%}
{%- endcapture -%}

    

<div class="variant-wrapper js ctm_{{ option.name | downcase }}"  data-type="button">
  <label class="variant__label{% if option.name == 'Default' or option.name == 'Title' %} hidden-label{% endif %}{% unless variant_labels %} hidden-label{% endunless %}"
    for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}">
  SELECT YOUR SIZE: (  {% if option.name contains 'colo' or option.name contains 'Colo' or option.name contains 'COLO' %}COLOUR{% else %}{{ option.name }}{% endif %})
    
    {%- if is_size -%}
      <span class="variant__label-info size-chart-drop">{%- if size_chart_content != blank -%}
          {%- render            
            'custom-tool-tip-trigger',
            title: size_chart_title,
            content: size_chart_content,
            context: 'size-chart'
          -%}
        {%- endif -%}
      </span>
    {%- endif -%}
    {% if option.name contains 'size' or option.name contains 'Size' %}
    <span class="variant__label-info">
      <span
            data-variant-color-label
            data-index="{{ forloop.index0 }}"
            data-option-index="{{ color_option_index }}">
        {{ option.selected_value }}
      </span>
    </span>
    {% endif %}
    
    {% if is_color %}
    <span class="variant__label-info"><span
            data-variant-color-label
            data-index="{{ forloop.index0 }}"
            data-option-index="{{ color_option_index }}">
        {{ option.selected_value }}
      </span>
    </span>
    {% endif %}
  </label>
  {%- assign option_index = forloop.index -%}
  
  {% assign new_option_index = 0 %}

{% for option in product.options %}
  {% if option == swatch %}
    {% assign found_option = true %}
    {% assign new_option_index = forloop.index0 %}
   
  {% endif %}
{% endfor %}
  
  
  <fieldset class="variant-input-wrap"
    name="{{ option.name }}"
    data-index="option{{ option_index }}"
    data-handle="{{ option.name | handleize }}"
    id="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}">
    <legend class="hide">{{ option.name }}</legend>
    {%- for value in option.values -%}
      {%- liquid
        assign product_available = true
        if product.options.size == 1
          assign product_available = product.variants[forloop.index0].available
        endif
        
        assign curr_variant = product.variants[forloop.index0]
        
      -%}
    
    {% assign values = '' %}
  {% assign curr_value = value %}
  {% for variant in product.variants %}
    {% assign new_value = variant.options[new_option_index] %}
    {% unless values contains new_value %}
      {% assign values = values | join: ',' %}
      {% assign values = values | append: ',' | append: new_value %} 
      {% assign values = values | split: ',' %}
      
   	  {%- if is_color -%}
  		{% if new_value contains curr_value %}
         {% assign img = variant.image %}
    	{%- endif -%}
  	  {%- endif -%}
    {% endunless %}
  {% endfor %}
    
      <div
        class="variant-input {% if is_color %}color_swatches {% endif %} option{{ option_index }}"
        data-index="option{{ option_index }}"
        data-value="{{ value | escape }}">
        <input type="radio" form="{{ form_id }}"
          {% if option.selected_value == value %} checked="checked"{% endif %}
          value="{{ value | escape }}"
          data-index="option{{ option_index }}"
          name="{{ option.name }}"
          data-variant-input
          class="{% unless product_available %} disabled{% endunless %}{% if is_color %} variant__input--color-swatch{% endif %}"
          {% if is_color %} data-color-name="{{ value | escape }}" id="color-{{forloop.index}}"  {% endif %}
          {% if is_color %} data-color-index="{{ color_option_index }}"{% endif %}
          id="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}" {% if option.selected_value == value %}checked{% endif %} %>
        
        {%- if is_color -%}
          {%- liquid
            assign color_file_name = value | handle | append: '.' | append: swatch_file_extension
            assign color_image = color_file_name | file_img_url: '200x200' | prepend: 'https:' | split: '?' | first
            assign color_swatch_fallback = value | split: ' ' | last | handle
          -%}
          <label for="color-{{forloop.index}}" class="img_wrapper" style="{% unless img != blank or curr_variant.image != blank %}background-color: {{ value | handleize }};{% else %}background-image:url({% if img != blank or curr_variant.image != blank %}{% if img %}{{ img | img_url: "small" }}{% else %}{{ curr_variant.image | img_url: "small" }}{% endif %}{% else %}{{ color_image }}{% endif %}){% endunless %}">
                 
            </label>
        {%- else -%}
          <label
            for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
            class="variant__button-label{% unless product_available %} disabled{% endunless %}">{{ value | escape }}</label>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </fieldset>
</div>
 
